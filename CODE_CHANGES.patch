+test("8.5 an instrumented successful consensus creates structured audit events", () => {
+    withTempDirectory(dir => {
+        const guard = new StateGuard(path.join(dir, "state"));
+        const nodes = [new Acceptor("A1"), new Acceptor("A2"), new Acceptor("A3")];
+        for (const node of nodes) guard.checkpoint(node);
+        const file = path.join(dir, "audit.jsonl");
+        const audit = new AuditLogger(file, { truncate: true });
+        const result = new Simulator(new Proposer("P1"), nodes, [new Learner("L1")], { stateGuard: guard, audit }).run("instances=10");
+        assert.equal(result.status, "CHOSEN");
+        const events = fs.readFileSync(file, "utf8").trim().split("\n").map(JSON.parse);
+        for (const type of ["PROPOSAL", "PROMISE", "QUORUM", "ACCEPTED", "CHOSEN"]) {
+            assert.ok(events.some(event => event.type === type), `Expected ${type}`);
+        }
+        const chosen = events.find(event => event.type === "CHOSEN");
+        assert.equal(chosen.value, "instances=10");
+        assert.equal(events.filter(event => event.type === "QUORUM").length, 2);
+        assert.equal(guard.verify(nodes[0]), true);
+    });
+});
